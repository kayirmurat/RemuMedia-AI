# OpenAI — LLM (araştırma/senaryo), görsel üretim ve seslendirme (TTS) için tek sağlayıcı.
# platform.openai.com/api-keys adresinden alınır.
OPENAI_API_KEY=

# Bir videonun toplam tahmini maliyeti bu değeri (USD) aşarsa üretim otomatik durur.
# Boş bırakılırsa varsayılan 2.0 kullanılır. --max-cost CLI bayrağı bunu geçici olarak ezer.
MAX_COST_PER_VIDEO=2.0

# --- Seedance / BytePlus ModelArk (opsiyonel, sadece --video bayrağı için) ---
# Statik görsel + Ken Burns yerine sahne başına gerçekten AKAN kısa bir video
# klip üretmek için gerekir. console.byteplus.com adresinden ModelArk API
# anahtarı oluşturulur.
ARK_API_KEY=
# DİKKAT: BytePlus konsolündeki "Model erişimi" sayfasından Seedance 2.5'in
# tam model ID'sini doğrula ve buraya yaz — kod içindeki varsayılan
# ("seedance-2-5-i2v") sadece bir tahmindir, gerçek ID'yle eşleşmeyebilir.
SEEDANCE_MODEL_ID=
# BytePlus saniye başı sabit bir liste fiyatı yayınlamıyor (token bazlı
# faturalandırıyor) — MAX_COST_PER_VIDEO güvenlik limitinin gerçek faturayı
# hafife almaması için buraya kendi faturana göre TAHMİNİ bir saniye başı
# USD değeri gir. Boş bırakılırsa kod içindeki (kasıtlı yüksek) varsayılan
# kullanılır.
SEEDANCE_PRICE_PER_SECOND_USD=

# --- Supabase (Faz 2, opsiyonel) ---
# İkisi de doluysa workflow/artifact durumu Supabase Postgres'te, üretilen
# dosyalar Supabase Storage'da tutulur. Boş bırakılırsa sistem otomatik olarak
# yerel JSON dosyalarına ve yerel diske düşer (Faz 1 davranışı).
# Project Settings > Data API (veya API Keys) sayfasından alınır.
# DİKKAT: SUPABASE_SECRET_KEY gizli bir anahtardır (service_role) — asla
# tarayıcıya/commit'e girmez, sadece bu .env dosyasında kalır.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Varsayılan: remumedia. Değiştirmek istemiyorsan boş bırak.
SUPABASE_BUCKET=
