# Faz 2'de oluşturduğun Supabase projesiyle aynı değerler.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Boş bırakılırsa "remumedia" kullanılır.
SUPABASE_BUCKET=

# GitHub'da "Yeni Video Üret" butonunun workflow_dispatch tetikleyebilmesi için:
# repo Settings > Actions izni olan bir Personal Access Token.
GITHUB_PAT=
# Varsayılan: kayirmurat/remumedia-ai. Değiştirmek istemiyorsan boş bırak.
GITHUB_REPO=

# Dashboard'a tek şifreli erişim koruması. Boş bırakılırsa dashboard herkese açık olur.
DASHBOARD_PASSWORD=

# Ses önizlemesi ("Dinle") için — sadece Supabase Storage'da önbelleklenmiş
# bir örnek yoksa (ör. yeni bir ses eklenirse) kullanılır, üretim akışındaki
# GITHUB_PAT ile tetiklenen video üretiminden bağımsızdır.
OPENAI_API_KEY=
